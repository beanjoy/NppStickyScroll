#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 254, 139
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sticky Scroll 设置"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "最多显示的父级行数（1–20）：", -1, 12, 15, 165, 12
    EDITTEXT IDC_MAX_ROWS, 185, 12, 48, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_MAX_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 0, 0, 0, 0
    GROUPBOX "超过最大行数时保留", -1, 10, 37, 233, 58
    CONTROL "最近层级（靠近当前内容，默认）", IDC_NEAREST, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 20, 52, 212, 13
    CONTROL "最外层级（靠近文档根节点）", IDC_OUTERMOST, "Button", BS_AUTORADIOBUTTON, 20, 73, 212, 13
    DEFPUSHBUTTON "确定", IDOK, 133, 112, 50, 16
    PUSHBUTTON "取消", IDCANCEL, 192, 112, 50, 16
END
